# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+17035551234        # the number you bought (save it in Contacts as "Pango")

# --- You ---
USER_PHONE_NUMBER=+17035556789          # your cell, E.164 format

# --- Security ---
# Any long random string; the iPhone Shortcut must send it.
# Generate one with: openssl rand -hex 24
TRIGGER_SECRET=change_me_to_a_long_random_string

# --- Upstash Redis (console.upstash.com, free tier) ---
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# --- Optional tuning ---
# MAX_ATTEMPTS=15                       # calls per exit before giving up
# RING_TIMEOUT_SECONDS=25               # ring time per attempt
# PUBLIC_BASE_URL=https://pango-agent.vercel.app   # only if auto-detection fails
# CALL_MESSAGE=...                      # override the spoken reminder
# SMS_MESSAGE=...                       # override the fallback text
