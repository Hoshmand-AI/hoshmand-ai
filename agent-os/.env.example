# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Default model for all agents; override per agent with AGENT_MODEL_<AGENTNAME>
AGENT_MODEL=claude-opus-5

# Google OAuth app (one Desktop-type OAuth client shared by all Gmail accounts)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Comma-separated account ids, e.g. personal1,personal2,gmu,work
GMAIL_ACCOUNTS=personal1,personal2

# One refresh token per account id (obtain with: npm run gmail-auth)
GMAIL_PERSONAL1_ADDRESS=sediq.ne@gmail.com
GMAIL_PERSONAL1_REFRESH_TOKEN=
GMAIL_PERSONAL2_ADDRESS=sediqzadaa@gmail.com
GMAIL_PERSONAL2_REFRESH_TOKEN=

# Max unread emails to triage per account per run
EMAIL_TRIAGE_BATCH=25
