# ─────────────────────────────────────────────────────────────────────────
# Saraf — autonomous trading agent. See docs/SARAF_DEPLOYMENT.md for the full
# deploy + go-live walkthrough. Copy this file to .env.local for local dev,
# or set these in your host's environment variables (e.g. Vercel).
# NEVER commit real keys. This file holds placeholders only.
# ─────────────────────────────────────────────────────────────────────────

# Risk gate (server-enforced, applies to every order)
# SARAF_MAX_NOTIONAL_USD=25        # hard cap per order in USD
# SARAF_LIVE_ENABLED=false         # set true ONLY when you intend real trades
# SARAF_KILL_SWITCH=false          # set true to halt all trading instantly

# Alpaca — recommended broker (trades Bitcoin, Oil/USO, Gold/GLD).
# Start with PAPER keys from https://alpaca.markets (real broker, fake money).
# ALPACA_API_KEY_ID=your_alpaca_key_id
# ALPACA_API_SECRET_KEY=your_alpaca_secret

# Coinbase — Bitcoin + PAXG gold only (no oil). CDP key from Coinbase.
# COINBASE_API_KEY_NAME=organizations/xxx/apiKeys/xxx
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Autonomous tick (Vercel Cron). Vercel sends this as a Bearer token.
# CRON_SECRET=generate_a_long_random_string
